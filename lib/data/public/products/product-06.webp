<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800">
    <rect width="800" height="800" fill="#101012"/>
    <radialGradient id="bgGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#C5A059" stop-opacity="0.12"/>
      <stop offset="100%" stop-color="#101012" stop-opacity="0"/>
    </radialGradient>
    <rect width="800" height="800" fill="url(#bgGlow)"/>
    
    <!-- Subtle Grid / Border Frame -->
    <rect x="24" y="24" width="752" height="752" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>
    
    
      <!-- Accessory Hardware -->
      <circle cx="400" cy="400" r="140" fill="#151413" stroke="#C5A059" stroke-width="3"/>
      <circle cx="400" cy="400" r="110" fill="#0d0d0e" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>
      <circle cx="400" cy="400" r="50" fill="none" stroke="#C5A059" stroke-width="2" stroke-dasharray="4 6"/>
      <text x="400" y="405" text-anchor="middle" font-family="Georgia, serif" font-size="14" fill="#C5A059" letter-spacing="3">NIAMAL</text>
    

    <!-- Bottom metadata -->
    <text x="400" y="740" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" fill="#5A5957" letter-spacing="4">EDITION 2026 • HANDCRAFTED</text>
  </svg>