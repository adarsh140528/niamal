<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800">
    <rect width="800" height="800" fill="#17130F"/>
    <radialGradient id="bgGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#D4AF37" stop-opacity="0.12"/>
      <stop offset="100%" stop-color="#17130F" stop-opacity="0"/>
    </radialGradient>
    <rect width="800" height="800" fill="url(#bgGlow)"/>
    
    <!-- Subtle Grid / Border Frame -->
    <rect x="24" y="24" width="752" height="752" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>
    
    
      <!-- Luxury Perfume Bottle -->
      <defs>
        <linearGradient id="glassGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#2a2824" stop-opacity="0.9"/>
          <stop offset="50%" stop-color="#141312" stop-opacity="0.95"/>
          <stop offset="100%" stop-color="#080808" stop-opacity="1"/>
        </linearGradient>
        <linearGradient id="goldCap" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#8F7238"/>
          <stop offset="50%" stop-color="#DEC68B"/>
          <stop offset="100%" stop-color="#735926"/>
        </linearGradient>
        <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="30" result="blur" />
          <feComposite in="SourceGraphic" in2="blur" operator="over"/>
        </filter>
      </defs>

      <!-- Ambient glow -->
      <circle cx="400" cy="450" r="180" fill="#D4AF37" opacity="0.08" filter="url(#glow)"/>

      <!-- Cap -->
      <rect x="345" y="160" width="110" height="90" rx="4" fill="url(#goldCap)" stroke="#D4AF37" stroke-width="1.5"/>
      <rect x="375" y="250" width="50" height="20" fill="#1C1C1E" stroke="#D4AF37" stroke-width="1"/>

      <!-- Bottle Body -->
      <rect x="250" y="270" width="300" height="420" rx="16" fill="url(#glassGrad)" stroke="rgba(255,255,255,0.12)" stroke-width="2"/>
      <rect x="260" y="280" width="280" height="400" rx="12" fill="none" stroke="rgba(197,160,89,0.2)" stroke-width="1"/>

      <!-- Glass reflections -->
      <line x1="280" y1="300" x2="280" y2="660" stroke="rgba(255,255,255,0.08)" stroke-width="3"/>
      <line x1="520" y1="300" x2="520" y2="660" stroke="rgba(255,255,255,0.04)" stroke-width="2"/>

      <!-- Gold Label Plate -->
      <rect x="290" y="420" width="220" height="130" rx="4" fill="#0E0D0C" stroke="#D4AF37" stroke-width="1.5"/>
      <text x="400" y="465" text-anchor="middle" font-family="Georgia, serif" font-size="16" fill="#D4AF37" letter-spacing="4">NIAMAL</text>
      <text x="400" y="495" text-anchor="middle" font-family="Georgia, serif" font-size="13" font-weight="bold" fill="#F7F5F0" letter-spacing="2">AMBRE SACRÉ</text>
      <text x="400" y="520" text-anchor="middle" font-family="system-ui, sans-serif" font-size="9" fill="#8E8D8A" letter-spacing="3">100 ML — PARIS / GRASSE</text>
    

    <!-- Bottom metadata -->
    <text x="400" y="740" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" fill="#5A5957" letter-spacing="4">EDITION 2026 • HANDCRAFTED</text>
  </svg>